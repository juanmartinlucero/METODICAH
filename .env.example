# ==============================================================================
# METODICAH - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo a `.env` o `.env.local` y ajusta los valores según tu entorno.
# 
# Modo Local (Default): Almacenamiento rápido en navegador (localStorage).
# Modo Firebase: Persistencia en la nube y sincronización remota en tiempo real.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Proveedor de Almacenamiento (Storage Provider)
# Opciones disponibles:
#   - 'local'    : Persistencia basada en LocalStorage + Mock initial data (Cero dependencias remotas)
#   - 'firebase' : Conexión activa a Google Cloud Firestore & Firebase Auth/Storage
# ------------------------------------------------------------------------------
VITE_STORAGE_PROVIDER=local

# ------------------------------------------------------------------------------
# 2. Credenciales de Google Firebase
# Obtenlas desde la Consola de Firebase -> Configuración del Proyecto -> Tus Apps -> Config
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=tu-api-key-de-firebase
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
